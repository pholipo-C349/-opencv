#include <iostream>
#include <string>
#include <opencv2/opencv.hpp>

using namespace cv;
using namespace std;

int main()
{
    string filename = "../test.png";
    string winname = "img";

    Mat img = imread(filename);
    // 先判断图片是否读到
    if (img.empty())
    {
        cout << "图片路径错误！读取失败" << endl;
        system("pause");
        return -1;
    }

    imshow(winname, img);

    Mat gray;
    cvtColor(img, gray, COLOR_BGR2GRAY);
    imshow("灰度图", gray);

    Mat blur;
    GaussianBlur(img, blur, Size(5, 5), 0);
    imshow("高斯模糊", blur);

    Mat edge;
    Canny(gray, edge, 50, 150);
    imshow("边缘检测", edge);

    Mat binary;
    threshold(gray, binary, 127, 255, THRESH_BINARY);
    imshow("二值图", binary);

    // 改这里！不卡死
    while (waitKey(1) != 27)
    {
        // 按ESC退出
    }

    destroyAllWindows();
    return 0;
}
